{
  "name": "cheddarbutlerchef",
  "version": "1.0.0",
  "description": "An app to help chefs with recipes given input ingredients.",
  "main": "index.js",
  "scripts": {
    "start": "npm run start-frontend",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start-backend": "cd ../backend && node index.js",
    "start-frontend": "cross-env PORT=3006 NODE_OPTIONS=--openssl-legacy-provider BROWSER=none react-scripts start",
    "start-all": "concurrently \"npm run start-backend\" \"npm run start-frontend\""
  },
  "dependencies": {
    "concurrently": "^6.0.0",
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^0.21.0",
    "openai": "^3.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "4.0.3",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "cooking"
  ],
  "author": "Leslie Cuadra Palacios",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
