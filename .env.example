# Example environment variables for local development and Netlify deployment.
# Copy this file to ".env" and fill in your keys.
# On Netlify, set these under Site settings → Environment variables.

# OpenAI API key — used by the generate-recipes Netlify function
OPENAI_API_KEY=sk-your-openai-key

# Optional: Bing Search API key for recipe URL enrichment
BING_SUBSCRIPTION_KEY=your-bing-search-key